# Environment configuration — FirmwareCouncil
# Copy to .env (gitignored) and fill in. NOTHING here contains real secrets; the
# examples below are placeholders demonstrated by the honest-fallback behaviour.

# ---------------------------------------------------------------- server
PORT=4100                       # @fc/api Fastify port
WEB_PORT=4300                   # @fc/web Next.js port

# Auth sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-value-32-bytes-hex-minimum

# ---------------------------------------------------------------- blockchain mirror (BOT Chain)
# Leave BOTH blank to run in "ANNOUNCED, not broadcast" mode (default, honest fallback).
# Set BOTH to broadcast real governance transactions via viem.
GOV_CHAIN_ID=968                # 968 = BOT Chain Testnet (rpc.bohr.life); 677 = mainnet (rpc.botchain.ai)
GOV_RPC_URL=https://rpc.bohr.life
GOV_CONTRACT_ADDRESS=           # 0x... — set after `npm run deploy -w @fc/deploy`
GOV_PRIVATE_KEY=                # 0x... — backend broadcaster burner key. NEVER reuse a personal key.
                                # Fund testnet tBOT via https://faucet.botchain.ai/basic
                                # After deploying, one-time: node --env-file=.env --import tsx packages/deploy/src/setup.mts
                                # (grants MANUFACTURER/OPERATOR to the broadcaster, registers relay signers)
GOV_OPERATOR_SIGNER_KEY=        # 0x... — operator decision signer (pure signer, needs NO funds; registered on-chain by setup.mts)
GOV_SECURITY_SIGNER_KEY=        # 0x... — security decision signer (as above). In production these are the approvers' keys.

# ---------------------------------------------------------------- contract deployment (@fc/deploy)
DEPLOY_NETWORK=testnet          # testnet only — mainnet deploys are deliberate, forge-driven, documented
DEPLOY_PRIVATE_KEY=             # burner key, MUST be funded before deploy; script refuses otherwise
GOV_MANUFACTURER=               # optional explicit role addresses (0x...); defaults derive deterministic ones
GOV_SECURITY_REVIEWER=
GOV_OPERATOR=
GOV_EMERGENCY_ADMIN=
GOV_BACKEND_MANUFACTURER_VALIDATOR=
GOV_BACKEND_SECURITY_VALIDATOR=
GOV_BACKEND_OPERATOR_VALIDATOR=

# ---------------------------------------------------------------- persistence (production = Postgres)
# The dev store is apps/api/data/db.json (see apps/api/prisma/schema.prisma for
# the production schema). No DATABASE_URL is used by the dev harness; it is
# listed here for completeness of the Prisma deployment path only.
# DATABASE_URL=postgres://user:password@host:5432/firmwarecouncil

# ---------------------------------------------------------------- OTA adapters
# secrets are referenced, never stored: credentialRef fields point into a vault.
# MENDER_BASE_URL=               # only for verified integrations; see INTEGRATION_LIMITATIONS.md
# HAWKBIT_TENANT=
# BALENA_API_TOKEN=
